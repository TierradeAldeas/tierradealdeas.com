---
import BaseLayout from "@components/base/BaseLayout.astro";
import PageHeader from "@components/common/PageHeader.astro";
import Social from "@components/common/Social.astro";

const socialLinks = {
  email: "tierradealdeas@gmail.com",
  youtube: "https://www.youtube.com/channel/UC6om5J4kwgRPlp0bnBpjO7g",
  pinterest: "https://es.pinterest.com/Tierradealdeasofficial/",
};
---

<BaseLayout title="Contacto" description="Cómo ponerte en contacto con Tierra de Aldeas">
  <PageHeader title="Contacto" />
  <section class="section">
    <div class="container">
      <div class="row justify-center">
        <div class="col-10 lg:col-6 glass rounded-lg p-6 text-center intersect:animate-fadeUp opacity-0">
          <p class="mb-4">Puedes escribirnos o seguirnos aquí:</p>
          <div class="flex justify-center">
            <Social links={socialLinks} />
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
